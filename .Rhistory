library(ggplot2)
# 1. Przygotowanie danych (odczytane ze zdjęcia)
cm_data <- data.frame(
Reference = rep(c("M0", "M1", "M2", "M3", "M4", "M5"), times = 6),
Prediction = rep(c("M0", "M1", "M2", "M3", "M4", "M5"), each = 6),
Value = c(
2, 0, 0, 0, 0, 0,  # Predykcja M0
0, 2, 2, 0, 1, 0,  # Predykcja M1
1, 4, 7, 0, 0, 0,  # Predykcja M2
0, 0, 0, 3, 0, 0,  # Predykcja M3
0, 2, 0, 0, 6, 1,  # Predykcja M4
0, 0, 0, 0, 0, 2   # Predykcja M5
)
)
# Wymuszenie odpowiedniej kolejności (M0 na górze osi Y, M0 po lewej na osi X)
cm_data$Prediction <- factor(cm_data$Prediction, levels = rev(c("M0", "M1", "M2", "M3", "M4", "M5")))
cm_data$Reference <- factor(cm_data$Reference, levels = c("M0", "M1", "M2", "M3", "M4", "M5"))
# 2. Rysowanie wykresu
p1 <- ggplot(cm_data, aes(x = Reference, y = Prediction, fill = Value)) +
# Kafelki z białym obramowaniem
geom_tile(color = "white", linewidth = 2) +
# Wartości wewnątrz kafelków
geom_text(aes(label = Value), fontface = "bold", size = 5) +
# Skala kolorów od białego do niebieskiego
scale_fill_gradient(low = "white", high = "#4388C5", name = "Liczba\npróbek") +
# Tytuły i etykiety
labs(
title = "Macierz Błędów (Confusion Matrix) - Random Forest",
subtitle = "Zestawienie predykcji modelu z rzeczywistymi podtypami FAB na zbiorze testowym",
x = "Rzeczywista diagnoza lekarza (Reference)",
y = "Przewidziana diagnoza przez model (Prediction)"
) +
# Minimalistyczny motyw jako baza
theme_minimal() +
# Dopracowanie detali (pogrubienia, usunięcie siatki)
theme(
plot.title = element_text(face = "bold", size = 16, hjust = 0),
plot.subtitle = element_text(size = 12, hjust = 0, margin = margin(b = 15)),
axis.title.x = element_text(face = "bold", margin = margin(t = 10)),
axis.title.y = element_text(face = "bold", margin = margin(r = 10)),
axis.text = element_text(size = 11, color = "gray40"),
panel.grid = element_blank() # Usunięcie tła i siatki
)
# Wyświetlenie
print(p1)
library(ggplot2)
# 1. Przygotowanie danych (odczytane ze zdjęcia)
bar_data <- data.frame(
Podtyp = factor(c("M0", "M1", "M2", "M3", "M4", "M5", "M6", "M7"),
levels = c("M0", "M1", "M2", "M3", "M4", "M5", "M6", "M7")),
Liczba = c(15, 35, 38, 14, 29, 15, 3, 2)
)
# 2. Rysowanie wykresu
p2 <- ggplot(bar_data, aes(x = Podtyp, y = Liczba)) +
# Słupki w odpowiednim kolorze niebieskim
geom_bar(stat = "identity", fill = "#4B8CDB", width = 0.65) +
# Etykiety nad słupkami
geom_text(aes(label = Liczba), vjust = -0.6, fontface = "bold", size = 4.5) +
# Tytuły
labs(
title = "Rozkład klas podtypów FAB",
x = "Podtyp FAB",
y = "Liczba pacjentów"
) +
# Skala osi Y z miejscem na etykiety tekstowe u góry
scale_y_continuous(limits = c(0, 42), breaks = seq(0, 30, by = 10)) +
theme_minimal() +
# Dopracowanie stylistyki
theme(
plot.title = element_text(face = "bold", size = 18, hjust = 0.5, margin = margin(b = 20)),
axis.title.x = element_text(face = "bold", margin = margin(t = 15)),
axis.title.y = element_text(face = "bold", margin = margin(r = 15)),
axis.text = element_text(size = 11, color = "gray30"),
# Usunięcie pionowych linii siatki, zostawienie tylko poziomych szarych
panel.grid.major.x = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major.y = element_line(color = "gray90", linewidth = 0.5)
)
# Wyświetlenie
print(p2)
